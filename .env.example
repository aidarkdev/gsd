APP_ENV=local
APP_DEBUG=false
APP_COOKIE_SECURE=false
APP_LOG=/var/www/gsd/storage/logs/app.log
APP_SESSION_PATH=/var/www/gsd/storage/sessions
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900

DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=gsd
DB_USER=gsd
DB_PASSWORD=change-me

ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=
